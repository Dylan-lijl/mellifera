{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-electron",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "lib": [
      "ES2023"
    ],
    "experimentalDecorators": true,
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "declaration": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
    }
  },
  "include": [
    "src",
    "electron.vite.config.ts",
  ]
}