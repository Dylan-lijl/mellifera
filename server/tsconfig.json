{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-electron",
    "rootDir": "./src",
    "allowImportingTsExtensions": false,
    "lib": [
      "ES2023"
    ],
    "moduleResolution": "Bundler",
    "strict": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src","electron.vite.config.ts"
  ]
}