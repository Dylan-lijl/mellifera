{
  "name": "server",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "productName": "pub.carzy.mellifera",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://repo.huaweicloud.com/electron-builder-binaries/ electron-builder"
  },
  "dependencies": {
    "@mellifera/common": "*",
    "@sapphire/snowflake": "^3.5.5",
    "@vue/reactivity": "^3.5.43",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "lru-cache": "^11.5.1",
    "playwright-core": "^1.59.1",
    "semver": "^7.8.5",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "superjson": "^2.2.6",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0-beta.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "icon": "logo/favicon",
    "asar": true,
    "appId": "${productName}",
    "copyright": "Copyright © 2026 Carzy",
    "directories": {
      "output": "release/${version}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "logo/favicon.ico",
        "to": "logo/favicon.ico"
      }
    ],
    "files": [
      "dist",
      "dist-electron",
      "!dist-electron/user-data",
      "!database.sqlite"
    ],
    "mac": {
      "icon": "logo/favicon.icns",
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "logo/favicon.png",
      "category": "Utility",
      "artifactName": "${productName}_${version}.${ext}"
    },
    "win": {
      "icon": "logo/favicon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}_${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "logo/favicon.ico",
      "uninstallerIcon": "logo/favicon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "executableName": "mellifera"
  }
}
